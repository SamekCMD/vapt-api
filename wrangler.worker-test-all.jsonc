{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vapt-api-worker-all-test",
  "main": "src/worker/test-fixture.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "preview",
    "CORS_ORIGINS": "https://app.vapt.test",
    "TEST_GREETING": "synthetic",
    "MERCADO_PAGO_CLIENT_ID": "synthetic",
    "MERCADO_PAGO_ENVIRONMENT": "sandbox",
    "R2_BUCKET_NAME": "synthetic",
    "TEST_MISC": "enabled",
    "PAYMENT_EFFECTS_ADMIN_SECRET": "synthetic-admin-secret"
  }
}

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
N8N_BASE_URL=https://n8n.example.com/webhook
N8N_TIMEOUT_MS=5000
VAPT_APP_ENDPOINT_SECRET=replace-me
VAPT_ADMIN_ENDPOINT_SECRET=replace-me
PAYMENT_EFFECTS_POLL_INTERVAL_MS=5000
PAYMENT_EFFECTS_BATCH_SIZE=25
PAYMENT_EFFECTS_LEASE_MS=60000
PAYMENT_EFFECTS_MAX_ATTEMPTS=5
PAYMENT_EFFECTS_RETRY_BASE_MS=30000
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_replace_me
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Trusted server-side Stripe price catalog. Never accept price IDs from the browser.
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_BUSINESS=price_replace_me
PUBLIC_ORDER_TOKEN_SECRET=replace-me

# Better Auth (use environment-specific secrets and exact frontend origins)
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://vapt:password@localhost:5432/vapt
TURNSTILE_SECRET_KEY=replace-me
RESEND_API_KEY=re_replace_me
RESEND_TEMPLATE_VERIFY_ACCOUNT=verify-account-template
RESEND_TEMPLATE_RESET_PASSWORD=reset-password-template
EMAIL_FROM=Vapt <noreply@example.com>

# Cloudflare R2 (configure o conjunto completo para habilitar as rotas de imagens)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=vapt-assets-preview
R2_PUBLIC_BASE_URL=https://assets-preview.example.com
R2_UPLOAD_URL_TTL_SECONDS=300

# Offline only: one-time Supabase Storage -> R2 migration (`npm run storage:migrate`).
# These values are read by the migration script itself and are not API runtime config.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=menu-images

# OAuth Mercado Pago para pagamentos de pedidos
MERCADO_PAGO_CLIENT_ID=replace-me
MERCADO_PAGO_CLIENT_SECRET=replace-me
MERCADO_PAGO_REDIRECT_URI=https://api.example.com/payments/mercado-pago/oauth/callback
MERCADO_PAGO_WEBHOOK_SECRET=replace-me
# Use sandbox durante a homologacao e altere para production somente no lancamento.
MERCADO_PAGO_ENVIRONMENT=sandbox
# No sandbox, use o Access Token exibido em Credenciais de teste da aplicacao.
# Nao configure esta variavel em producao; nesse ambiente cada restaurante usa OAuth.
MERCADO_PAGO_TEST_ACCESS_TOKEN=APP_USR-replace-with-test-access-token
# Gere 32 bytes aleatorios e codifique em base64; nao reutilize outras chaves.
PAYMENT_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FRONTEND_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com

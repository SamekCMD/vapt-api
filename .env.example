NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=https://dashboard.vapt.app.br,https://vapt.app.br
LOG_LEVEL=info

# Endpoint administrativo do reconciliador de pagamentos, independente do n8n.
VAPT_ADMIN_ENDPOINT_SECRET=replace-with-random-server-only-secret
PAYMENT_EFFECTS_POLL_INTERVAL_MS=5000
PAYMENT_EFFECTS_BATCH_SIZE=25
PAYMENT_EFFECTS_LEASE_MS=60000
PAYMENT_EFFECTS_MAX_ATTEMPTS=5
PAYMENT_EFFECTS_RETRY_BASE_MS=30000

SUPABASE_URL=https://supabase.vapt.app.br
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Necessária no fallback HS256 da API atual; não remover antes de validar a transição JWKS.
SUPABASE_JWT_SECRET=replace-with-self-hosted-jwt-secret

# OAuth Mercado Pago para pagamentos de pedidos. Configure o bloco inteiro
# em Coolify quando homologar MP; configuração parcial impede o boot.
# MERCADO_PAGO_CLIENT_ID=replace-with-client-id
# MERCADO_PAGO_CLIENT_SECRET=replace-with-client-secret
# MERCADO_PAGO_REDIRECT_URI=https://api.vapt.app.br/payments/mercado-pago/oauth/callback
# MERCADO_PAGO_WEBHOOK_SECRET=replace-with-webhook-secret
MERCADO_PAGO_ENVIRONMENT=sandbox
# Somente sandbox; em produção cada restaurante usa OAuth.
# MERCADO_PAGO_TEST_ACCESS_TOKEN=APP_USR-replace-with-test-access-token
# Gere 32 bytes aleatórios e codifique em base64; não reutilize outras chaves.
# PAYMENT_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# FRONTEND_URL=https://dashboard.vapt.app.br
# API_PUBLIC_URL=https://api.vapt.app.br

# LEGACY / DEFERRED: NÃO configure N8N_BASE_URL, N8N_TIMEOUT_MS,
# VAPT_APP_ENDPOINT_SECRET ou STRIPE_WEBHOOK_SIGNING_SECRET neste ambiente.

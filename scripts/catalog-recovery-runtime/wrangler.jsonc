{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vapt-catalog-recovery-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"LOCAL_SQL_ORIGIN":"http://127.0.0.1:1","LOCAL_RESTAURANT":"","LOCAL_OPERATION":"","LOCAL_FAULT":"","LOCAL_NOW":0},
  "r2_buckets": [{"binding":"LOCAL_CATALOG","bucket_name":"vapt-local-recovery-test"}],
  "durable_objects": {"bindings":[{"name":"RECOVERY_COORDINATOR","class_name":"LocalCatalogRecovery"}]},
  "migrations": [{"tag":"local-recovery-v1","new_sqlite_classes":["LocalCatalogRecovery"]}]
}

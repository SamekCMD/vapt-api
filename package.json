{
  "name": "vapt-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:worker": "wrangler deploy --dry-run --config wrangler.worker.jsonc",
    "verify:production-public": "node scripts/verify-public-production-config.mjs wrangler.worker-production-public.jsonc",
    "build:worker-production-public": "npm run verify:production-public && wrangler deploy --dry-run --config wrangler.worker-production-public.jsonc",
    "deploy:worker-production-public": "npm run verify:production-public && wrangler deploy --config wrangler.worker-production-public.jsonc --keep-vars",
    "verify:production-realtime": "node scripts/verify-realtime-production-config.mjs wrangler.worker-production-realtime.jsonc",
    "build:worker-production-realtime": "npm run verify:production-realtime && wrangler deploy --dry-run --config wrangler.worker-production-realtime.jsonc",
    "deploy:worker-production-realtime": "npm run verify:production-realtime && wrangler deploy --config wrangler.worker-production-realtime.jsonc --keep-vars",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:worker": "tsx --test \"src/worker/*.workerd.ts\"",
    "test:auth-retention": "node --expose-gc --test-isolation=none --import tsx --test src/worker/auth-retention.gc.ts",
    "storage:migrate": "tsx src/scripts/migrate-menu-images-to-r2.ts",
    "generate:supabase-keys": "node scripts/generate-supabase-jwt-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/cors": "^11.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "better-auth": "1.7.6",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "hono": "^4.13.11",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "resend": "6.28.1",
    "stripe": "22.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "^22.14.1",
    "@types/pg": "8.20.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "4.138.0"
  }
}

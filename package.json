{
  "name": "vapt-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "storage:migrate": "tsx src/scripts/migrate-menu-images-to-r2.ts",
    "generate:supabase-keys": "node scripts/generate-supabase-jwt-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/cors": "^11.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "better-auth": "1.7.6",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "resend": "6.28.1",
    "stripe": "22.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/pg": "8.20.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
